+export async function pMapSettled(
+	iterable,
+	mapper,
+	{
+		concurrency = Number.POSITIVE_INFINITY,
+		signal,
+	} = {},
+) {
+	if (typeof mapper !== 'function') {
+		throw new TypeError('Mapper function is required');
+	}
+
+	return pMap(iterable, async (element, index) => {
+		try {
+			const value = await mapper(element, index);
+			return value === pMapSkip ? pMapSkip : {status: 'fulfilled', value};
+		} catch (reason) {
+			return {status: 'rejected', reason};
+		}
+	}, {concurrency, signal, stopOnError: true});
+}
