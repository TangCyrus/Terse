+export async function pMapSettled(input, mapper, {concurrency, signal} = {}) {
+	if (typeof mapper !== 'function') {
+		throw new TypeError('Mapper function is required');
+	}
+
+	return pMap(input, async (value, index) => {
+		try {
+			const result = await mapper(value, index);
+			return result === pMapSkip ? pMapSkip : {status: 'fulfilled', value: result};
+		} catch (error) {
+			return {status: 'rejected', reason: error};
+		}
+	}, {concurrency, signal});
+}
