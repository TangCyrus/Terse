+import type { Order } from './orders.ts';
+
+// Yield complete CSV records: quoted customer names may contain newlines.
+export function* orderCsvRows(
+  orders: readonly Order[],
+  ownerId: string,
+  status?: Order['status'],
+): Generator<string> {
+  if (!ownerId) throw new Error('ownerId is required');
+  yield 'id,customer,total,status';
+
+  for (const order of orders) {
+    if (order.ownerId !== ownerId || (status !== undefined && order.status !== status)) continue;
+    if (!Number.isFinite(order.total) || order.total < 0) {
+      throw new Error(`Invalid total for ${order.id}`);
+    }
+    const customer = `"${order.customer.replaceAll('"', '""')}"`;
+    yield [order.id, customer, order.total.toFixed(2), order.status].join(',');
+  }
+}
