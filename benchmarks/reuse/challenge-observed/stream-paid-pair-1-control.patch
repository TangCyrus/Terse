@@ -0,0 +1,12 @@
+import { orderCsvRows } from './order-csv.ts';
+import type { Order } from './orders.ts';
+
+export async function streamPaidOrders(
+  orders: readonly Order[],
+  ownerId: string,
+  emit: (row: string) => void | Promise<void>,
+): Promise<void> {
+  for (const row of orderCsvRows(orders, ownerId, 'paid')) {
+    await emit(row);
+  }
+}
