@@ -0,0 +1,11 @@
+import { exportOrderRows, type Order } from './orders.ts';
+
+export async function streamPaidOrders(
+  orders: readonly Order[],
+  ownerId: string,
+  emit: (row: string) => unknown | Promise<unknown>,
+): Promise<void> {
+  for (const row of exportOrderRows(orders, ownerId, 'paid')) {
+    await emit(row);
+  }
+}
