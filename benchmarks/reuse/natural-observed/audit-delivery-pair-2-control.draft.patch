@@ -0,0 +1,25 @@
+import type {Order} from '../orders.ts';
+import {csvCell, ORDER_HEADER, orderRecord} from '../reporting/csv.ts';
+
+export interface AuditAuthorization {
+  readonly auditor: boolean;
+  readonly owners?: readonly string[];
+  readonly statuses?: readonly Order['status'][];
+}
+
+export async function streamAuditCsv(
+  orders: readonly Order[],
+  authorization: AuditAuthorization,
+  emit: (record: string) => unknown,
+): Promise<void> {
+  if (authorization.auditor !== true) {
+    throw new Error('Auditor authorization is required');
+  }
+
+  await emit(`ownerId,${ORDER_HEADER}`);
+  for (const order of orders) {
+    if (authorization.owners !== undefined && !authorization.owners.includes(order.ownerId)) continue;
+    if (authorization.statuses !== undefined && !authorization.statuses.includes(order.status)) continue;
+    await emit(`${csvCell(order.ownerId)},${orderRecord(order)}`);
+  }
+}
