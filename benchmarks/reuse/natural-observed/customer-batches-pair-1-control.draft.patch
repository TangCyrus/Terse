+import type {Order} from '../orders.ts';
+import {selectCustomerOrders} from '../domain/selection.ts';
+import {renderOrderCsv} from '../reporting/csv.ts';
+
+export interface CustomerBatchOptions {
+  size: number;
+  status?: Order['status'];
+  afterId?: string;
+}
+
+export interface CustomerBatch {
+  csv: string;
+  nextCursor: string | null;
+}
+
+export async function streamCustomerBatches(
+  orders: readonly Order[],
+  ownerId: string,
+  options: CustomerBatchOptions,
+  emit: (batch: CustomerBatch) => void | Promise<unknown>,
+): Promise<void> {
+  if (typeof ownerId !== 'string' || !ownerId) {
+    throw new Error('ownerId is required');
+  }
+  if (!options || typeof options !== 'object' || Array.isArray(options)) {
+    throw new Error('options are required');
+  }
+  const {size, status, afterId} = options;
+  if (!Number.isInteger(size) || size < 1 || size > 1000) {
+    throw new Error('size must be an integer from 1 to 1000');
+  }
+  if (status !== undefined && status !== 'paid' && status !== 'pending') {
+    throw new Error('status must be paid or pending');
+  }
+  if (afterId !== undefined && typeof afterId !== 'string') {
+    throw new Error('afterId must be a string');
+  }
+
+  const selected = selectCustomerOrders(orders, ownerId, status);
+  const ids = new Set<string>();
+  let start = 0;
+  let cursorFound = afterId === undefined;
+  for (let index = 0; index < selected.length; index++) {
+    const {id} = selected[index];
+    if (ids.has(id)) throw new Error(`Duplicate order ID: ${id}`);
+    ids.add(id);
+    if (afterId !== undefined && id === afterId) {
+      start = index + 1;
+      cursorFound = true;
+    }
+  }
+  if (!cursorFound) throw new Error('afterId must identify a selected order');
+
+  if (start === selected.length) {
+    await emit({csv: renderOrderCsv([]), nextCursor: null});
+    return;
+  }
+  for (let offset = start; offset < selected.length; offset += size) {
+    const batch = selected.slice(offset, offset + size);
+    const hasMore = offset + size < selected.length;
+    await emit({
+      csv: renderOrderCsv(batch),
+      nextCursor: hasMore ? batch[batch.length - 1].id : null,
+    });
+  }
+}
