@@ -0,0 +1,63 @@
+import type {Order} from '../orders.ts';
+import {selectCustomerOrders} from '../domain/selection.ts';
+import {renderOrderCsv} from '../reporting/csv.ts';
+
+export interface CustomerBatchOptions {
+  size: number;
+  status?: Order['status'];
+  afterId?: string;
+}
+
+export interface CustomerBatch {
+  csv: string;
+  nextCursor: string | null;
+}
+
+export async function streamCustomerBatches(
+  orders: readonly Order[],
+  ownerId: string,
+  options: CustomerBatchOptions,
+  emit: (batch: CustomerBatch) => void | Promise<void>,
+): Promise<void> {
+  if (typeof ownerId !== 'string' || !ownerId) {
+    throw new Error('ownerId is required');
+  }
+  if (!options || typeof options !== 'object' || Array.isArray(options)) {
+    throw new Error('Invalid batch options');
+  }
+  const {size, status, afterId} = options;
+  if (!Number.isInteger(size) || size < 1 || size > 1000) {
+    throw new Error('size must be an integer between 1 and 1000');
+  }
+  if (status !== undefined && status !== 'paid' && status !== 'pending') {
+    throw new Error('Invalid status');
+  }
+  if (afterId !== undefined && (typeof afterId !== 'string' || !afterId)) {
+    throw new Error('Invalid afterId cursor');
+  }
+  if (typeof emit !== 'function') throw new Error('emit must be a function');
+
+  const selected = selectCustomerOrders(orders, ownerId, status);
+  const ids = new Set<string>();
+  let start = 0;
+  for (let index = 0; index < selected.length; index++) {
+    const id = selected[index].id;
+    if (ids.has(id)) throw new Error(`Duplicate order id: ${id}`);
+    ids.add(id);
+    if (id === afterId) start = index + 1;
+  }
+  if (afterId !== undefined && !ids.has(afterId)) {
+    throw new Error('afterId cursor must exist in the selected orders');
+  }
+
+  // Slice orders rather than CSV lines: quoted fields can contain newlines.
+  // The loop also delivers one header-only batch when no records remain.
+  do {
+    const end = Math.min(start + size, selected.length);
+    await emit({
+      csv: renderOrderCsv(selected.slice(start, end)),
+      nextCursor: end < selected.length ? selected[end - 1].id : null,
+    });
+    start = end;
+  } while (start < selected.length);
+}
