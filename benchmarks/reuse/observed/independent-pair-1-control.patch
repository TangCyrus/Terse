+import type { Order } from './orders.ts';
+import { serializeOrders } from './orderCsv.ts';
+
+// Auditors may export orders across all owners.
+export function exportAuditOrders(orders: Order[], isAuditor: boolean): string {
+  if (isAuditor !== true) throw new Error('auditor access is required');
+  return serializeOrders(orders);
+}
diff --git a/src/orderCsv.ts b/src/orderCsv.ts
new file mode 100644
index 0000000..9441340
--- /dev/null
+++ b/src/orderCsv.ts
@@ -0,0 +1,13 @@
+import type { Order } from './orders.ts';
+
+// Callers are responsible for authorization and visibility selection.
+export function serializeOrders(orders: Order[]): string {
+  const rows = orders.map(order => {
+    if (!Number.isFinite(order.total) || order.total < 0) {
+      throw new Error(`Invalid total for ${order.id}`);
+    }
+    const customer = `"${order.customer.replaceAll('"', '""')}"`;
+    return [order.id, customer, order.total.toFixed(2), order.status].join(',');
+  });
+  return ['id,customer,total,status', ...rows].join('\n');
+}
