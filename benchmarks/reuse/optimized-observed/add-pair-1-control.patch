+export interface Notification {
+  readonly id: string;
+  readonly to: string;
+  readonly message: string;
+}
+
+export function enqueueNotification(
+  pending: readonly Notification[],
+  item: Notification,
+): Notification[] {
+  if (
+    !item ||
+    [item.id, item.to, item.message].some(
+      value => typeof value !== 'string' || value.trim().length === 0,
+    )
+  ) {
+    throw new Error('Invalid notification: id, to and message are required');
+  }
+
+  if (pending.some(notification => notification.id === item.id)) {
+    return [...pending];
+  }
+
+  return [...pending, { ...item }];
+}
