@@ -0,0 +1,16 @@
+import {type EventEmitter} from 'eventemitter3';
+
+export async function waitForEvent(emitter: EventEmitter, event: string | symbol, filter?: () => boolean): Promise<void> {
+	return new Promise(resolve => {
+		const listener = () => {
+			if (filter && !filter()) {
+				return;
+			}
+
+			emitter.off(event, listener);
+			resolve();
+		};
+
+		emitter.on(event, listener);
+	});
+}
