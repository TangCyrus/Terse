{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terse CLI output v1",
  "type": "object",
  "required": ["schemaVersion", "toolVersion", "command", "outputKind", "status", "exitCode", "errors", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "toolVersion": { "type": "string" },
    "command": { "enum": ["init", "begin", "context", "decide", "simplify", "check", "help", "version", null] },
    "outputKind": { "enum": ["result", "error"] },
    "status": { "enum": ["pass", "fail", "needs-review", "incomplete"] },
    "exitCode": { "enum": [0, 1, 2, 3] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "verificationGuide": {
      "type": "object", "required": ["argvTemplate", "verificationOwner", "notes"],
      "properties": {
        "argvTemplate": { "type": "array", "items": { "type": "string" } },
        "verificationOwner": { "const": "check" },
        "notes": { "type": "string" }
      }
    },
    "verification": { "type": "array", "items": { "type": "object", "properties": {
      "outputOmitted": { "const": true },
      "failureOutput": { "type": "string", "maxLength": 2048 },
      "failureOutputTruncated": { "type": "boolean" }
    } } },
    "similarityAlgorithm": { "const": "implementation-anchors/1" },
    "possibleDuplications": { "type": "integer", "minimum": 0 },
    "undeclaredRemovals": { "type": "array", "items": { "type": "object", "required": ["path"], "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "symbol": { "type": "string" } }
    } },
    "findings": { "type": "array", "items": { "type": "object", "properties": {
      "similarity": { "type": "object", "required": ["algorithm", "shared", "sharedAnchors", "leftAnchors", "rightAnchors", "evidenceTruncated"],
        "properties": {
          "algorithm": { "const": "implementation-anchors/1" },
          "shared": { "type": "object", "required": ["literals", "members", "calls"], "properties": {
            "literals": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
            "members": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
            "calls": { "type": "array", "maxItems": 20, "items": { "type": "string" } }
          } },
          "sharedAnchors": { "type": "integer", "minimum": 8 },
          "leftAnchors": { "type": "integer", "minimum": 8 },
          "rightAnchors": { "type": "integer", "minimum": 8 },
          "evidenceTruncated": { "type": "boolean" }
        }
      }
    } } },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "stage"],
        "properties": {
          "code": { "enum": ["INVALID_ARGUMENT", "PROJECT_ERROR", "COMMAND_ERROR", "CONTEXT_INCOMPLETE", "CHECK_INCOMPLETE"] },
          "message": { "type": "string" },
          "stage": { "enum": ["arguments", "project", "command"] },
          "causeCode": { "type": "string" },
          "issues": { "type": "array", "items": { "type": "object", "required": ["field", "code", "message"],
            "properties": { "field": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } } } }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "pass" } } }, "then": { "properties": { "exitCode": { "const": 0 } } } },
    { "if": { "properties": { "status": { "const": "fail" } } }, "then": { "properties": { "exitCode": { "const": 1 } } } },
    { "if": { "properties": { "status": { "const": "needs-review" } } }, "then": { "properties": { "exitCode": { "const": 2 } } } },
    { "if": { "properties": { "status": { "const": "incomplete" } } }, "then": { "properties": { "exitCode": { "const": 3 }, "errors": { "minItems": 1 }, "diagnostics": { "minItems": 1 } } } },
    { "if": { "properties": { "outputKind": { "const": "error" } } }, "then": { "properties": { "status": { "const": "incomplete" } } } },
    {
      "if": { "properties": { "outputKind": { "const": "result" } } },
      "then": {
        "oneOf": [
          { "properties": { "command": { "const": "init" }, "files": { "type": "array", "items": {
            "type": "object", "required": ["path", "status"], "properties": {
              "path": { "type": "string" }, "status": { "enum": ["created", "updated", "unchanged", "preserved"] }
            }
          } }, "verificationConfigured": { "type": "boolean" }, "runnerArgv": { "type": "array", "items": { "type": "string" } } },
            "required": ["root", "skillPath", "instructionsPath", "files", "verificationConfigured", "runnerArgv", "setupIssues", "next"] },
          { "properties": { "command": { "const": "begin" } }, "required": ["run", "root", "snapshotHash", "scannedFiles", "decisionPath"] },
          { "properties": { "command": { "const": "context" } }, "required": ["run", "query", "snapshotHash", "scannedFiles", "candidates", "fileMatches", "unresolvedImports"] },
          { "properties": { "command": { "const": "decide" } }, "required": ["run", "decisionPath", "decision"] },
          { "properties": { "command": { "const": "check" } }, "required": ["run", "baselineHash", "snapshotHash", "findings", "verification", "changes"] },
          { "properties": { "command": { "const": "simplify" }, "applied": { "type": "boolean" }, "simplificationVerified": { "type": "boolean" }, "plan": { "type": "object" } }, "required": ["run", "applied", "simplificationVerified", "plan", "limitations"] },
          { "properties": { "command": { "const": "help" }, "help": { "type": "string" } }, "required": ["help"] },
          { "properties": { "command": { "const": "version" } } }
        ]
      }
    }
  ]
}
