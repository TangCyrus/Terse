{
  "name": "terse-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Task-scoped reuse discovery and incremental duplication checks for coding agents",
  "type": "module",
  "bin": { "terse": "dist/cli.js" },
  "files": ["dist", "skills", "README.md", "DESIGN.md", "docs/CLI.md", "docs/AGENT-INTEGRATION.md", "docs/SIMILARITY.md", "docs/cli-output.schema.json", "docs/decision.schema.json"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "terse": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:agent": "npm run build && node scripts/demo-agent.mjs",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "benchmark:agent": "npm run build && node scripts/benchmark-agent.mjs",
    "benchmark:reuse": "npm run build && node scripts/benchmark-reuse.mjs",
    "benchmark:skill": "npm run build && node scripts/benchmark-skill.mjs"
  },
  "dependencies": { "@jscpd/core": "4.2.5", "@jscpd/tokenizer": "4.2.6", "typescript": "5.9.3" },
  "devDependencies": { "@types/node": "24.0.0" }
}
